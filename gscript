      buyerPhone:          data.buyerPhone         || '',
      buyerEmail:          data.buyerEmail         || '',
      buyerAddress:        data.buyerAddress       || '',
      buyerGstin:          data.buyerGstin         || '',
      buyerState:          data.buyerState         || '',
      stateCode:           data.stateCode          || '',
      subTotal:            data.subTotal           || 0,
      cgstRate:            data.cgstRate           || 0,
      sgstRate:            data.sgstRate           || 0,
      igstRate:            data.igstRate           || 0,
      cgstAmount:          data.cgstAmount         || 0,
      sgstAmount:          data.sgstAmount         || 0,
      igstAmount:          data.igstAmount         || 0,
      taxAmount:           data.taxAmount          || 0,
      grandTotal:          data.grandTotal         || 0,
      items:               JSON.parse(itemsJson)
    };
    var emailResult = sendCreditDebitNoteEmail(emailPayload);
    emailSent    = emailResult.sent;
    emailMessage = emailResult.message;
  } catch (emailErr) {
    emailMessage = emailErr.toString();
    Logger.log('Credit/Debit Note email error: ' + emailMessage);
  }

  return jsonOut({ success: true, emailSent: emailSent, emailMessage: emailMessage });
}

// ─────────────────────────────────────────────────────────────────────────
// AUTO EMAIL — CREDIT/DEBIT NOTE PDF SENDER
// ─────────────────────────────────────────────────────────────────────────

function sendCreditDebitNoteEmail(data) {
  const SELLER_EMAIL = 'itransform007@gmail.com';

  const htmlContent = buildCreditDebitNoteHtmlGas(data);

  const docLabel       = (data.noteType === 'DEBIT') ? 'Debit Note' : 'Credit Note';
  const safeNoteNo      = (data.noteNo    || docLabel).replace(/\//g, '-');
  const safeBuyerName   = (data.buyerName || 'Customer').replace(/[^a-zA-Z0-9 ]/g, '').trim();
  const pdfFileName     = safeBuyerName + ' - ' + safeNoteNo + '.pdf';

  var tempFile = null;
  var pdfBlob;
  try {
    tempFile = DriveApp.createFile(
      Utilities.newBlob(htmlContent, 'text/html', 'temp_creditdebitnote.html')
    );
    pdfBlob = tempFile.getAs('application/pdf');
    pdfBlob.setName(pdfFileName);
  } finally {
    if (tempFile) {
      try { tempFile.setTrashed(true); } catch(e) { Logger.log('Temp file cleanup: ' + e); }
    }
  }

  const rawDate = gasDateToYMD(data.date);
  const fmtDate = rawDate ? rawDate.split('-').reverse().join('-') : '-';
  const subject = 'New ' + docLabel + ' Saved: ' + (data.noteNo || '') + ' | ' + (data.buyerName || 'Unknown Customer');

  const emailBody =
    'A new ' + docLabel.toLowerCase() + ' has been saved to Google Sheets.\n\n' +
    docLabel + ' Details:\n' +
    '  ' + docLabel + ' No. : ' + (data.noteNo    || '-') + '\n' +
    '  Date          : ' + fmtDate + '\n' +
    '  Customer      : ' + (data.buyerName || '-') + '\n' +
    '  Against Invoice: ' + (data.againstInvoiceNo || '-') + '\n' +
    '  Grand Total   : Rs.' + parseFloat(data.grandTotal || 0).toFixed(2) + '\n' +
    (data.reason ? '  Reason        : ' + data.reason + '\n' : '') +
    '\nPlease find the ' + docLabel.toLowerCase() + ' PDF attached.\n\n' +
    '-- G.M. Enterprises ' + docLabel + ' System';

  MailApp.sendEmail(SELLER_EMAIL, subject, emailBody, {
    name:        'G.M. Enterprises — ' + docLabel + ' System',
    attachments: [pdfBlob]
  });

  Logger.log(docLabel + ' email sent to ' + SELLER_EMAIL + ' for ' + (data.noteNo || ''));
  return { sent: true, message: 'Email sent to ' + SELLER_EMAIL };
}

